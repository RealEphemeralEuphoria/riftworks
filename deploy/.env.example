# Copy to .env next to each docker-compose.yml on the server, then chmod 600 .env.
# Real values never go in the repo.

# Discord webhook for this environment's #dev-log, in Watchtower's form.
# From https://discord.com/api/webhooks/<id>/<token>, write it token first:
WATCHTOWER_NOTIFICATION_URL=discord://<token>@<id>
